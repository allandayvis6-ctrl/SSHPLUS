#!/bin/bash
#====================================================
#	@allandayvis6
#====================================================
cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
SCOLOR='\033[0m'
RED='\033[1;31m'
[[ $(awk -F" " '{print $2}' /usr/lib/licence) == "@KIRITO_SSH" ]] && {
	ram1=$(free -h | grep -i mem | awk {'print $2'})
	ram2=$(free -h | grep -i mem | awk {'print $4'})
	ram3=$(free -h | grep -i mem | awk {'print $3'})
	uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
	system=$(cat /etc/issue.net)

	fun_bar() {
		comando[0]="$1"
		comando[1]="$2"
		(
			[[ -e $HOME/fim ]] && rm $HOME/fim
			[[ ! -d /etc/SSHPlus ]] && rm -rf /bin/menu
			${comando[0]} >/dev/null 2>&1
			${comando[1]} >/dev/null 2>&1
			touch $HOME/fim
		) >/dev/null 2>&1 &
		tput civis
		echo -ne "\033[1;33mAGUARDE \033[1;37m- \033[1;33m["
		while true; do
			for ((i = 0; i < 18; i++)); do
				echo -ne "\033[1;31m#"
				sleep 0.1s
			done
			[[ -e $HOME/fim ]] && rm $HOME/fim && break
			echo -e "\033[1;33m]"
			sleep 1s
			tput cuu1
			tput dl1
			echo -ne "\033[1;33mAGUARDE \033[1;37m- \033[1;33m["
		done
		echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
		tput cnorm
	}

	verif_ptrs() {
		local porta=$1
		if [[ -z "$porta" || ! "$porta" =~ ^[0-9]+$ || "$porta" -lt 1 || "$porta" -gt 65535 ]]; then
			echo -e "\n\033[1;31mPorta invalida!\033[0m"
			return 1
		fi
		if command -v lsof >/dev/null 2>&1; then
			if lsof -V -i tcp -P -n 2>/dev/null | grep "LISTEN" | grep -qE "[:.]${porta}( |$)"; then
				echo -e "\n\033[1;31mPORTA \033[1;33m$porta \033[1;31mJA ESTA EM USO\033[0m"
				return 1
			fi
		elif command -v ss >/dev/null 2>&1; then
			if ss -ltnH 2>/dev/null | awk '{print $4}' | grep -qE "(:|\])${porta}$"; then
				echo -e "\n\033[1;31mPORTA \033[1;33m$porta \033[1;31mJA ESTA EM USO\033[0m"
				return 1
			fi
		elif netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "(:|\])${porta}$"; then
			echo -e "\n\033[1;31mPORTA \033[1;33m$porta \033[1;31mJA ESTA EM USO\033[0m"
			return 1
		fi
		return 0
	}

	slow_setup() {
		[[ -e "/bin/slowdns" ]] && {
			slowdns
		} || {
			cd $HOME
			wget https://raw.githubusercontent.com/allandayvis6-ctrl/SSHPLUS/main/Slowdns/install -O /dev/null
			chmod 777 install
			./install
		}
	}

	fun_socks() {
		clear
		echo -e "\E[44;1;37m            GERENCIAR PROXY SOCKS             \E[0m"
		echo ""

		if command -v ss >/dev/null 2>&1; then
			PORTAS_ATIVAS=$(ss -tlpn 2>/dev/null | grep -E 'proxy\.py|wsproxy\.py|python' | awk '{print $4}' | awk -F: '{print $NF}' | sort -nu | xargs)
		else
			PORTAS_ATIVAS=$(netstat -nplt 2>/dev/null | grep -E 'proxy\.py|wsproxy\.py|python' | awk '{print $4}' | awk -F: '{print $NF}' | sort -nu | xargs)
		fi

		if [[ -n "$PORTAS_ATIVAS" ]]; then
			sks="${GREEN}ON${SCOLOR}"
			echo -e "\033[1;33mPORTAS\033[1;37m: \033[1;32m${PORTAS_ATIVAS}\033[0m"
		else
			sks="${RED}OFF${SCOLOR}"
		fi

		SCREENS=$(screen -ls 2>/dev/null)
		echo "$SCREENS" | grep -qw 'proxy' && var_sks1="\033[1;32m◉" || var_sks1="\033[1;31m○"
		echo "$SCREENS" | grep -qw 'ws' && var_sks2="\033[1;32m◉" || var_sks2="\033[1;31m○"
		echo "$SCREENS" | grep -qw 'openpy' && sksop="\033[1;32m◉" || sksop="\033[1;31m○"

		echo ""
		echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mSOCKS SSH $var_sks1 \033[0m"
		echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mWEBSOCKET $var_sks2 \033[0m"
		echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mSOCKS OPENVPN $sksop \033[0m"
		echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;37m• \033[1;33mABRIR PORTA\033[0m"
		echo -e "\033[1;31m[\033[1;36m5\033[1;31m] \033[1;37m• \033[1;33mALTERAR STATUS SOCKS SSH\033[0m"
		echo -e "\033[1;31m[\033[1;36m6\033[1;31m] \033[1;37m• \033[1;33mALTERAR STATUS WEBSOCKET\033[0m"
		echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mVOLTAR\033[0m"
		echo ""
		echo -ne "\033[1;32mO QUE DESEJA FAZER \033[1;33m?\033[1;37m "
		read -r resposta

		case "$resposta" in
		1)
			if pgrep -f "[p]roxy\.py" >/dev/null 2>&1; then
				clear
				echo -e "\E[41;1;37m             PROXY SOCKS              \E[0m"
				echo ""
				fun_socksoff() {
					local pidproxy
					for pidproxy in $(screen -ls 2>/dev/null | awk '/\.proxy[[:space:]]/{print $1}'); do
						screen -S "$pidproxy" -X quit >/dev/null 2>&1
					done
					[[ -f /etc/autostart ]] && sed -i '/proxy\.py/d' /etc/autostart
					sleep 1
					screen -wipe >/dev/null 2>&1
				}
				echo -e "\033[1;32mDESATIVANDO O PROXY SOCKS\033[1;33m"
				echo ""
				fun_bar 'fun_socksoff'
				echo ""
				echo -e "\033[1;32mPROXY SOCKS DESATIVADO COM SUCESSO!\033[1;33m"
				sleep 2
				fun_socks
			else
				clear
				echo -e "\E[44;1;37m             PROXY SOCKS              \E[0m"
				echo ""
				echo -ne "\033[1;32mQUAL PORTA DESEJA UTILIZAR \033[1;33m?\033[1;37m: "
				read -r porta
				if [[ -z "$porta" || ! "$porta" =~ ^[0-9]+$ || "$porta" -lt 1 || "$porta" -gt 65535 ]]; then
					echo ""
					echo -e "\033[1;31mPorta invalida!\033[0m"
					sleep 2
					fun_conexao
					return
				fi
				verif_ptrs "$porta" || { fun_socks; return; }
				fun_inisocks() {
					sleep 1
					screen -dmS proxy python3 /etc/SSHPlus/proxy.py "$porta"
					touch /etc/autostart
					sed -i '/proxy\.py/d' /etc/autostart
					echo "ss -tlpn | grep -qw \"$porta\" || { screen -S 'proxy' -X quit >/dev/null 2>&1; screen -dmS proxy python3 /etc/SSHPlus/proxy.py \"$porta\"; }" >>/etc/autostart
				}
				echo ""
				echo -e "\033[1;32mINICIANDO O PROXY SOCKS\033[1;33m"
				echo ""
				fun_bar 'fun_inisocks'
				echo ""
				echo -e "\033[1;32mSOCKS ATIVADO COM SUCESSO\033[1;33m"
				sleep 2
				fun_socks
			fi
			;;
		2)
			if pgrep -f "[w]sproxy\.py" >/dev/null 2>&1; then
				clear
				echo -e "\E[41;1;37m             WEBSOCKET PROXY              \E[0m"
				echo ""
				fun_wsoff() {
					local pidws
					for pidws in $(screen -ls 2>/dev/null | awk '/\.ws[[:space:]]/{print $1}'); do
						screen -S "$pidws" -X quit >/dev/null 2>&1
					done
					[[ -f /etc/autostart ]] && sed -i '/wsproxy\.py/d' /etc/autostart
					sleep 1
					screen -wipe >/dev/null 2>&1
				}
				echo -e "\033[1;32mDESATIVANDO O WEBSOCKET\033[1;33m"
				echo ""
				fun_bar 'fun_wsoff'
				echo ""
				echo -e "\033[1;32mWEBSOCKET DESATIVADO COM SUCESSO!\033[1;33m"
				sleep 2
				fun_socks
			else
				clear
				echo -e "\E[44;1;37m             WEBSOCKET PROXY              \E[0m"
				echo ""
				echo -ne "\033[1;32mQUAL PORTA DESEJA UTILIZAR \033[1;33m?\033[1;37m: "
				read -r porta
				if [[ -z "$porta" || ! "$porta" =~ ^[0-9]+$ || "$porta" -lt 1 || "$porta" -gt 65535 ]]; then
					echo ""
					echo -e "\033[1;31mPorta invalida!\033[0m"
					sleep 2
					fun_conexao
					return
				fi
				verif_ptrs "$porta" || { fun_socks; return; }
				fun_iniws() {
					sleep 1
					screen -dmS ws python3 /etc/SSHPlus/wsproxy.py "$porta"
					touch /etc/autostart
					sed -i '/wsproxy\.py/d' /etc/autostart
					echo "ss -tlpn | grep -qw \"$porta\" || { screen -S 'ws' -X quit >/dev/null 2>&1; screen -dmS ws python3 /etc/SSHPlus/wsproxy.py \"$porta\"; }" >>/etc/autostart
				}
				echo ""
				echo -e "\033[1;32mINICIANDO O WEBSOCKET\033[1;33m"
				echo ""
				fun_bar 'fun_iniws'
				echo ""
				echo -e "\033[1;32mWEBSOCKET ATIVADO COM SUCESSO\033[1;33m"
				sleep 2
				fun_socks
			fi
			;;
		3)
			if pgrep -f "[o]pen\.py" >/dev/null 2>&1; then
				clear
				echo -e "\E[41;1;37m            SOCKS OPENVPN             \E[0m"
				echo ""
				for pidproxy in $(screen -ls 2>/dev/null | awk '/\.openpy[[:space:]]/{print $1}'); do
					screen -S "$pidproxy" -X quit >/dev/null 2>&1
				done
				[[ -f /etc/autostart ]] && sed -i '/open\.py/d' /etc/autostart
				fun_socks
			else
				clear
				echo -e "\E[44;1;37m            SOCKS OPENVPN             \E[0m"
				echo ""
				echo -ne "\033[1;32mQUAL PORTA DESEJA UTILIZAR \033[1;33m?\033[1;37m: "
				read -r porta
				if [[ -z "$porta" || ! "$porta" =~ ^[0-9]+$ || "$porta" -lt 1 || "$porta" -gt 65535 ]]; then
					echo -e "\033[1;31mPorta invalida!\033[0m"
					sleep 2
					fun_socks
					return
				fi
				verif_ptrs "$porta" || { fun_socks; return; }
				fun_inisocksop() {
					sleep 1
					screen -dmS openpy python3 /etc/SSHPlus/open.py "$porta"
					touch /etc/autostart
					sed -i '/open\.py/d' /etc/autostart
					echo "ss -tlpn | grep -qw \"$porta\" || { screen -S 'openpy' -X quit >/dev/null 2>&1; screen -dmS openpy python3 /etc/SSHPlus/open.py \"$porta\"; }" >>/etc/autostart
				}
				fun_bar 'fun_inisocksop'
				sleep 2
				fun_socks
			fi
			;;
		4)
			if pgrep -f "[p]roxy\.py" >/dev/null 2>&1; then
				echo -ne "\033[1;32mQUAL PORTA DESEJA UTILIZAR \033[1;33m?\033[1;37m: "
				read -r porta
				if [[ -z "$porta" || ! "$porta" =~ ^[0-9]+$ || "$porta" -lt 1 || "$porta" -gt 65535 ]]; then
					echo -e "\033[1;31mPorta invalida!\033[0m"
					sleep 2
					fun_socks
					return
				fi
				verif_ptrs "$porta" || { fun_socks; return; }
				screen -dmS proxy python3 /etc/SSHPlus/proxy.py "$porta"
			else
				echo -e "\033[1;31mATIVE O SOCKS PRIMEIRO !\033[0m"
				sleep 2
			fi
			fun_socks
			;;
		5)
			if pgrep -f "[p]roxy\.py" >/dev/null 2>&1; then
				clear
				msgsocks=$(grep -E '^[[:space:]]*MSG[[:space:]]*=' /etc/SSHPlus/proxy.py | head -1 | awk -F= '{print $2}' | tr -d "'\" ")
				echo -e "\E[44;1;37m             PROXY SOCKS              \E[0m"
				echo -e "\033[1;33mSTATUS: \033[1;32m$msgsocks"
				echo -ne "\033[1;32mINFORME SEU STATUS\033[1;31m:\033[1;37m "
				read -r msgg
				if [[ -z "$msgg" ]]; then
					echo -e "\n\033[1;31mStatus invalido!\033[0m"
					sleep 2
					fun_socks
					return
				fi
				if [[ ${msgg} != ?(+|-)+([a-zA-Z0-9-. ]) ]]; then
					echo -e "\n\033[1;31mEVITE CARACTERES ESPECIAIS\033[0m"
					sleep 2
					fun_socks
					return
				fi
				echo -ne "\033[1;32mQUAL A COR (1-AZUL, 2-VERDE, 3-VERMELHO, 4-AMARELO, 5-ROSA, 6-CYANO, 7-LARANJA, 8-ROXO, 9-PRETO, 10-SEM COR)\033[1;37m: "
				read -r sts_cor
				case "$sts_cor" in
					1|01) cor_sts='blue' ;;
					2|02) cor_sts='green' ;;
					3|03) cor_sts='red' ;;
					4|04) cor_sts='yellow' ;;
					5|05) cor_sts='#F535AA' ;;
					6|06) cor_sts='cyan' ;;
					7|07) cor_sts='#FF7F00' ;;
					8|08) cor_sts='#9932CD' ;;
					9|09) cor_sts='black' ;;
					10) cor_sts='null' ;;
					*) cor_sts='null' ;;
				 esac
				sed -i -E "s/(^[[:space:]]*MSG[[:space:]]*=).*/\1 '$msgg'/" /etc/SSHPlus/proxy.py
				sed -i -E "s/(color=)[^\" ]*/\1$cor_sts/" /etc/SSHPlus/proxy.py
				_pidsks=$(screen -ls 2>/dev/null | awk '/\.proxy[[:space:]]/{print $1}')
				for pidproxy in $_pidsks; do screen -S "$pidproxy" -X quit >/dev/null 2>&1; done
				_ptssks=$(ss -tlpn 2>/dev/null | grep 'proxy.py' | awk '{print $4}' | awk -F: '{print $NF}' | xargs)
				[[ -n "$_ptssks" ]] && for pt in $_ptssks; do screen -dmS proxy python3 /etc/SSHPlus/proxy.py "$pt"; done
				fun_socks
			else
				echo -e "\033[1;31mATIVE O SOCKS SSH PRIMEIRO !\033[0m"
				sleep 2
				fun_socks
			fi
			;;
		6)
			if pgrep -f "[w]sproxy\.py" >/dev/null 2>&1; then
				clear
				msgsocks=$(grep -E '^[[:space:]]*MSG[[:space:]]*=' /etc/SSHPlus/wsproxy.py | head -1 | awk -F= '{print $2}' | tr -d "'\" ")
				echo -e "\E[44;1;37m             WEBSOCKET              \E[0m"
				echo -e "\033[1;33mSTATUS: \033[1;32m$msgsocks"
				echo -ne "\033[1;32mINFORME SEU STATUS\033[1;31m:\033[1;37m "
				read -r msgg
				if [[ -z "$msgg" ]]; then
					echo -e "\n\033[1;31mStatus invalido!\033[0m"
					sleep 2
					fun_socks
					return
				fi
				echo -ne "\033[1;32mQUAL A COR (1-AZUL, 2-VERDE, 3-VERMELHO, 4-AMARELO, 5-ROSA, 6-CYANO, 7-LARANJA, 8-ROXO, 9-PRETO, 10-SEM COR)\033[1;37m: "
				read -r sts_cor
				case "$sts_cor" in
					1|01) cor_sts='blue' ;;
					2|02) cor_sts='green' ;;
					3|03) cor_sts='red' ;;
					4|04) cor_sts='yellow' ;;
					5|05) cor_sts='#F535AA' ;;
					6|06) cor_sts='cyan' ;;
					7|07) cor_sts='#FF7F00' ;;
					8|08) cor_sts='#9932CD' ;;
					9|09) cor_sts='black' ;;
					10) cor_sts='null' ;;
					*) cor_sts='null' ;;
				 esac
				sed -i -E "s/(^[[:space:]]*MSG[[:space:]]*=).*/\1 '$msgg'/" /etc/SSHPlus/wsproxy.py
				sed -i -E "s/(color=)[^\" ]*/\1$cor_sts/" /etc/SSHPlus/wsproxy.py
				_pids=$(screen -ls 2>/dev/null | awk '/\.ws[[:space:]]/{print $1}')
				for pidws in $_pids; do screen -S "$pidws" -X quit >/dev/null 2>&1; done
				_ptws=$(ss -tlpn 2>/dev/null | grep 'wsproxy.py' | awk '{print $4}' | awk -F: '{print $NF}' | xargs)
				[[ -n "$_ptws" ]] && for pt in $_ptws; do screen -dmS ws python3 /etc/SSHPlus/wsproxy.py "$pt"; done
				fun_socks
			else
				echo -e "\033[1;31mATIVE O WEBSOCKET PRIMEIRO !\033[0m"
				sleep 2
				fun_socks
			fi
			;;
		0)
			fun_conexao
			return
			;;
		*)
			echo -e "\033[1;31mOpcao invalida!\033[0m"
			sleep 1
			fun_socks
			;;
		esac
	}

	fun_conexao() {
		while true; do
			[[ ! -e '/home/sshplus' ]] && exit 0
			clear
			echo -e "\E[44;1;37m                MODO DE CONEXAO                 \E[0m\n"
			echo -e "\033[1;32mSERVICO: \033[1;33mOPENSSH \033[1;32mPORTA: \033[1;37m$(grep 'Port' /etc/ssh/sshd_config | cut -d' ' -f2 | grep -v 'no' | xargs)" && sts6="\033[1;32m◉ "

			[[ "$(netstat -tlpn 2>/dev/null | grep 'docker' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICO: \033[1;33mCHISEL: \033[1;32mPORTA: \033[1;37m$(netstat -nplt 2>/dev/null | grep 'docker' | awk '{print $4}' | cut -d: -f2 | xargs)"
				sts8="\033[1;32m◉ "
			} || sts8="\033[1;31m○ "
			[[ "$(ps x | grep 'slowdns' | grep -v 'grep' | wc -l)" != '0' ]] && sts9="\033[1;32m◉ " || sts9="\033[1;31m○ "
			[[ "$(netstat -tlpn 2>/dev/null | grep 'sslh' | wc -l)" != '0' ]] && sts7="\033[1;32m◉ " || sts7="\033[1;31m○ "
			[[ "$(netstat -tlpn 2>/dev/null | grep 'openvpn' | wc -l)" != '0' ]] && sts5="\033[1;32m◉ " || sts5="\033[1;31m○ "
			[[ "$(netstat -tlpn 2>/dev/null | grep 'python' | wc -l)" != '0' ]] && sts4="\033[1;32m◉ " || sts4="\033[1;31m○ "
			[[ -e "/etc/stunnel/stunnel.conf" ]] && sts3="\033[1;32m◉ " || sts3="\033[1;31m○ "
			[[ "$(netstat -tlpn 2>/dev/null | grep 'dropbear' | wc -l)" != '0' ]] && sts2="\033[1;32m◉ " || sts2="\033[1;31m○ "
			[[ "$(netstat -tlpn 2>/dev/null | grep 'squid' | wc -l)" != '0' ]] && sts1="\033[1;32m◉ " || sts1="\033[1;31m○ "
			[[ "$(netstat -tunlp 2>/dev/null | grep 'trojan-go' | wc -l)" != '0' ]] && trojansts="\033[1;32m◉ " || trojansts="\033[1;31m○ "
			[[ "$(netstat -tunlp 2>/dev/null | grep 'v2ray' | wc -l)" != '0' ]] && xv2ray="\033[1;32m◉ " || xv2ray="\033[1;31m○ "

			echo -e "\033[0;34m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
			echo ""
			echo -e "\033[1;31m[\033[1;36m01\033[1;31m] \033[1;37m• \033[1;33mOPENSSH $sts6\033[1;31m"
			echo -e "[\033[1;36m02\033[1;31m] \033[1;37m• \033[1;33mSQUID PROXY $sts1\033[1;31m"
			echo -e "[\033[1;36m03\033[1;31m] \033[1;37m• \033[1;33mDROPBEAR $sts2\033[1;31m"
			echo -e "[\033[1;36m04\033[1;31m] \033[1;37m• \033[1;33mOPENVPN $sts5\033[1;31m"
			echo -e "[\033[1;36m05\033[1;31m] \033[1;37m• \033[1;33mPROXY SOCKS $sts4\033[1;31m"
			echo -e "[\033[1;36m06\033[1;31m] \033[1;37m• \033[1;33mSSL TUNNEL $sts3\033[1;31m"
			echo -e "[\033[1;36m07\033[1;31m] \033[1;37m• \033[1;33mSSLH MULTIPLEX $sts7\033[1;31m"
			echo -e "[\033[1;36m08\033[1;31m] \033[1;37m• \033[1;33mCHISEL $sts8\033[1;31m"
			echo -e "[\033[1;36m09\033[1;31m] \033[1;37m• \033[1;33mSLOWDNS $sts9\033[1;31m"
			echo -e "[\033[1;36m10\033[1;31m] \033[1;37m• \033[1;33mV2RAY $xv2ray\033[1;31m"
			echo -e "[\033[1;36m11\033[1;31m] \033[1;37m• \033[1;33mTROJAN-GO $trojansts\033[1;31m"
