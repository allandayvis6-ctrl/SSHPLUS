#!/bin/bash
#====================================================
#	@allandayvis6 (corrigido e revisado)
#====================================================
shopt -s extglob

cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
SCOLOR='\033[0m'

# Fallback simples caso fun_conexao não tenha sido carregada de outro arquivo
declare -f fun_conexao >/dev/null 2>&1 || fun_conexao() {
	return 0
}

# Helper para listar portas TCP em escuta (usa ss se netstat não existir)
get_listening_tcp() {
	if command -v ss >/dev/null 2>&1; then
		ss -tlpn 2>/dev/null
	elif command -v netstat >/dev/null 2>&1; then
		netstat -nltp 2>/dev/null
	fi
}

[[ -f /usr/lib/licence ]] && LICENCA=$(awk -F" " '{print $2}' /usr/lib/licence) || LICENCA=""

[[ "$LICENCA" == "@KIRITO_SSH" ]] && {
	ram1=$(free -h 2>/dev/null | awk '/^[Mm]em:/ {print $2}')
	ram2=$(free -h 2>/dev/null | awk '/^[Mm]em:/ {print $4}')
	ram3=$(free -h 2>/dev/null | awk '/^[Mm]em:/ {print $3}')
	uso=$(top -bn1 2>/dev/null | awk '/Cpu/ { printf "%.1f%%", 100 - $8 }')
	system=$(cat /etc/issue.net 2>/dev/null)

	fun_bar() {
		local cmd1="$1"
		local cmd2="$2"
		local fim_flag="$HOME/.fim_fun_bar_$$"

		(
			rm -f "$fim_flag"
			[[ -n "$cmd1" ]] && eval "$cmd1" >/dev/null 2>&1
			[[ -n "$cmd2" ]] && eval "$cmd2" >/dev/null 2>&1
			touch "$fim_flag"
		) &

		tput civis 2>/dev/null
		echo -ne "\033[1;33mAGUARDE \033[1;37m- \033[1;33m["
		while true; do
			for ((i = 0; i < 18; i++)); do
				echo -ne "\033[1;31m#"
				sleep 0.1s
			done
			if [[ -e "$fim_flag" ]]; then
				rm -f "$fim_flag"
				break
			fi
			echo -e "\033[1;33m]"
			sleep 1s
			tput cuu1 2>/dev/null
			tput dl1 2>/dev/null
			echo -ne "\033[1;33mAGUARDE \033[1;37m- \033[1;33m["
		done
		echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK !\033[1;37m"
		tput cnorm 2>/dev/null
	}

	verif_ptrs() {
		local porta="$1"
		[[ -z "$porta" ]] && return 0

		if command -v lsof >/dev/null 2>&1; then
			local PT pton svcs
			PT=$(lsof -V -i tcp -P -n 2>/dev/null | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
			for pton in $(echo -e "$PT" | awk -F':' '{print $NF}' | awk '{print $1}' | sort -u); do
				if [[ "$porta" == "$pton" ]]; then
					svcs=$(echo -e "$PT" | awk -v p=":$porta " '$0 ~ p {print $1}' | sort -u | tr '\n' ' ')
					echo -e "\n\033[1;31mPORTA \033[1;33m$porta \033[1;31mEM USO PELO \033[1;37m${svcs:-SERVICO}\033[0m"
					sleep 3
					fun_conexao
					return 1
				fi
			done
		elif command -v ss >/dev/null 2>&1; then
			if ss -tlpn 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$porta$"; then
				echo -e "\n\033[1;31mPORTA \033[1;33m$porta \033[1;31mPODE ESTAR EM USO!\033[0m"
				sleep 3
				fun_conexao
				return 1
			fi
		fi
		return 0
	}

	slow_setup() {
		if [[ -e "/bin/slowdns" ]]; then
			slowdns
		else
			cd "$HOME" || return 1
			wget -q https://raw.githubusercontent.com/allandayvis6-ctrl/SSHPLUS/main/Slowdns/install -O install
			chmod +x install
			./install
		fi
	}

	inst_sqd() {
		if get_listening_tcp | grep -q 'squid'; then
			echo -e "\E[41;1;37m            REMOVER SQUID PROXY              \E[0m"
			echo ""
			echo -ne "\033[1;32mREALMENTE DESEJA REMOVER O SQUID \033[1;31m? \033[1;33m[s/n]:\033[1;37m "
			read -r resp
			if [[ "${resp,,}" == 's' ]]; then
				echo -e "\n\033[1;32mREMOVENDO O SQUID PROXY !\033[0m\n"
				rem_sqd() {
					apt-get purge -y squid squid3 >/dev/null 2>&1
					apt-get autoremove -y >/dev/null 2>&1
					rm -rf /etc/squid /etc/squid3 >/dev/null 2>&1
				}
				fun_bar 'rem_sqd'
				echo -e "\n\033[1;32mSQUID REMOVIDO COM SUCESSO !\033[0m"
				sleep 2
				clear
				fun_conexao
			else
				echo -e "\n\033[1;31mRetornando...\033[0m"
				sleep 2
				clear
				fun_conexao
			fi
		else
			clear
			echo -e "\E[44;1;37m              INSTALADOR SQUID                \E[0m\n"
			local IP ipdovps portass opc var_sqd var_pay
			IP=$(wget -4qO- ipv4.icanhazip.com 2>/dev/null)
			echo -ne "\033[1;32mPARA CONTINUAR CONFIRME SEU IP: \033[1;37m"
			read -e -i "$IP" ipdovps
			if [[ -z "$ipdovps" ]]; then
				echo -e "\n\033[1;31mIP invalido\033[0m"
				read -rp "Digite seu IP: " ipdovps
				[[ -z "$ipdovps" ]] && {
					echo -e "\n\033[1;31mIP vazio. Cancelando...\033[0m"
					sleep 2
					fun_conexao
					return
				}
			fi

			echo -e "\n\033[1;33mQUAIS PORTAS DESEJA UTILIZAR NO SQUID \033[1;31m?"
			echo -e "\n\033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mDEFINA AS PORTAS EM SEQUENCIA \033[1;33mEX: \033[1;37m80 8080\n"
			echo -ne "\033[1;32mINFORME AS PORTAS\033[1;37m: "
			read -r portass
			if [[ -z "$portass" ]]; then
				echo -e "\n\033[1;31mPorta invalida!"
				sleep 3
				fun_conexao
				return
			fi
			for porta in $portass; do
				verif_ptrs "$porta" || return
			done

			if grep -qE '\b(14|8)\b' /etc/issue.net 2>/dev/null; then
				echo -e "\n\033[1;32mINSTALANDO SQUID PROXY\033[0m\n"
				fun_bar 'apt-get update -y' 'apt-get install squid3 -y'
			else
				echo -e "\n\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mSQUID PADRÃO DO SISTEMA\n\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mSQUID (PACOTE SQUID3)\033[0m\n"
				read -rp "$(echo -e "\033[1;32mINFORME UMA OPÇÃO \033[1;37m: ")" -e -i 1 opc
				if [[ "$opc" != '1' && "$opc" != '2' ]]; then
					echo -e "\n\033[1;31mOpcao invalida !"
					sleep 2
					fun_conexao
					return
				fi
				echo -e "\n\033[1;32mINSTALANDO SQUID PROXY\033[0m\n"
				if [[ "$opc" == '1' ]]; then
					fun_bar 'apt-get update -y' 'apt-get install squid -y'
				else
					fun_bar 'apt-get update -y' 'apt-get install squid3 -y'
				fi
			fi

			if [[ -d "/etc/squid/" ]]; then
				var_sqd="/etc/squid/squid.conf"
				var_pay="/etc/squid/payload.txt"
			elif [[ -d "/etc/squid3/" ]]; then
				var_sqd="/etc/squid3/squid.conf"
				var_pay="/etc/squid3/payload.txt"
			else
				echo -e "\n\033[1;33m[\033[1;31mERRO\033[1;33m]\033[1;37m: \033[1;33mO SQUID PROXY CORROMPEU\033[0m"
				sleep 2
				fun_conexao
				return
			fi

			cat <<-EOF >"$var_pay"
				.whatsapp.net/
				.facebook.net/
				.twitter.com/
				.speedtest.net/
			EOF

			cat <<-EOF >"$var_sqd"
				acl url1 dstdomain -i 127.0.0.1
				acl url2 dstdomain -i localhost
				acl url3 dstdomain -i $ipdovps
				acl url4 dstdomain -i /SSHPLUS?
				acl payload url_regex -i "$var_pay"
				acl all src 0.0.0.0/0

				http_access allow url1
				http_access allow url2
				http_access allow url3
				http_access allow url4
				http_access allow payload
				http_access deny all

				#Portas
			EOF

			for Pts in $portass; do
				echo "http_port $Pts" >>"$var_sqd"
				command -v ufw >/dev/null 2>&1 && ufw allow "$Pts/tcp" >/dev/null 2>&1
			done

			cat <<-EOF >>"$var_sqd"
				#Nome squid
				visible_hostname SSHPLUS
				via off
				forwarded_for off
				pipeline_prefetch off
			EOF

			sqd_conf() {
				systemctl restart ssh 2>/dev/null || service ssh restart
				if [[ -d "/etc/squid/" ]]; then
					systemctl restart squid 2>/dev/null || service squid restart || /etc/init.d/squid restart
				elif [[ -d "/etc/squid3/" ]]; then
					systemctl restart squid3 2>/dev/null || service squid3 restart || /etc/init.d/squid3 restart
				fi
			}

			echo -e "\n\033[1;32mCONFIGURANDO SQUID PROXY\033[0m\n"
			fun_bar 'sqd_conf'
			echo -e "\n\033[1;32mSQUID INSTALADO COM SUCESSO!\033[0m"
			sleep 2.5s
			fun_conexao
		fi
	}

	addpt_sqd() {
		local var_sqd pt
		echo -e "\E[44;1;37m         ADICIONAR PORTA AO SQUID         \E[0m"
		echo -e "\n\033[1;33mPORTAS EM USO: \033[1;32m${sqdp:-N/A}\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;31mSQUID NAO ESTA INSTALADO!\033[0m"
			sleep 2
			clear
			fun_squid
			return
		fi

		echo -ne "\033[1;32mQUAL PORTA DESEJA ADICIONAR \033[1;33m?\033[1;37m "
		read -r pt
		if [[ -z "$pt" || ! "$pt" =~ ^[0-9]+$ ]]; then
			echo -e "\n\033[1;31mPorta invalida!"
			sleep 2
			clear
			fun_squid
			return
		fi
		verif_ptrs "$pt" || return

		echo -e "\n\033[1;32mADICIONANDO PORTA AO SQUID!\n"
		sed -i "s|#Portas|#Portas\nhttp_port $pt|" "$var_sqd"
		fun_bar 'sleep 2'
		echo -e "\n\033[1;32mREINICIANDO O SQUID!\n"
		fun_bar 'systemctl restart squid squid3 2>/dev/null || service squid restart 2>/dev/null || service squid3 restart 2>/dev/null'
		echo -e "\n\033[1;32mPORTA ADICIONADA COM SUCESSO!"
		sleep 3
		clear
		fun_squid
	}

	rempt_sqd() {
		local var_sqd pt
		echo -e "\E[41;1;37m        REMOVER PORTA DO SQUID        \E[0m"
		echo -e "\n\033[1;33mPORTAS EM USO: \033[1;32m${sqdp:-N/A}\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;31mSQUID NAO ESTA INSTALADO!\033[0m"
			sleep 2
			clear
			fun_squid
			return
		fi

		echo -ne "\033[1;32mQUAL PORTA DESEJA REMOVER \033[1;33m?\033[1;37m "
		read -r pt
		if [[ -z "$pt" || ! "$pt" =~ ^[0-9]+$ ]]; then
			echo -e "\n\033[1;31mPorta invalida!"
			sleep 2
			clear
			fun_squid
			return
		fi

		if grep -qE "^http_port[[:space:]]+$pt([[:space:]]|$)" "$var_sqd"; then
			echo -e "\n\033[1;32mREMOVENDO PORTA DO SQUID!\n"
			sed -i "/^http_port[[:space:]]\+$pt\([[:space:]]\|$\)/d" "$var_sqd"
			fun_bar 'sleep 3'
			echo -e "\n\033[1;32mREINICIANDO O SQUID!\n"
			fun_bar 'systemctl restart squid squid3 2>/dev/null || service squid restart 2>/dev/null || service squid3 restart 2>/dev/null'
			echo -e "\n\033[1;32mPORTA REMOVIDA COM SUCESSO!"
			sleep 3.5s
			clear
			fun_squid
		else
			echo -e "\n\033[1;31mPORTA \033[1;32m$pt \033[1;31mNAO ENCONTRADA!"
			sleep 3.5s
			clear
			fun_squid
		fi
	}

	fun_squid() {
		local sqd_count VarSqdOn x
		sqd_count=$(get_listening_tcp | grep -c 'squid')
		if [[ "$sqd_count" == "0" ]]; then
			inst_sqd
			return
		fi

		echo -e "\E[44;1;37m          GERENCIAR SQUID PROXY           \E[0m"
		sqdp=$(get_listening_tcp | grep 'squid' | awk '{print $4}' | awk -F':' '{print $NF}' | sort -u | xargs)
		echo -e "\n\033[1;33mPORTAS\033[1;37m: \033[1;32m$sqdp"
		VarSqdOn="REMOVER SQUID PROXY"

		echo -e "\n\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33m$VarSqdOn
\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mADICIONAR PORTA
\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mREMOVER PORTA
\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mVOLTAR\033[0m\n"
		echo -ne "\033[1;32mOQUE DESEJA FAZER \033[1;33m?\033[1;31m?\033[1;37m "
		read -r x
		clear
		case "$x" in
		1 | 01) inst_sqd ;;
		2 | 02) addpt_sqd ;;
		3 | 03) rempt_sqd ;;
		0 | 00)
			echo -e "\033[1;31mRetornando...\033[0m"
			sleep 1
			fun_conexao
			;;
		*)
			echo -e "\033[1;31mOpcao Invalida...\033[0m"
			sleep 2
			fun_conexao
			;;
		esac
	}

	fun_drop() {
		local dpbr stats resposta pt porta var1
		if get_listening_tcp | grep -q 'dropbear'; then
			clear
			dpbr=$(get_listening_tcp | grep 'dropbear' | awk '{print $4}' | awk -F':' '{print $NF}' | sort -u | xargs)
			[[ -z "$dpbr" ]] && dpbr="\033[1;31mINDISPONIVEL"

			if ps x | grep -E "[d]roplimiter|[l]imiter" >/dev/null 2>&1; then
				stats='\033[1;32m◉ '
			else
				stats='\033[1;31m○ '
			fi

			echo -e "\E[44;1;37m              GERENCIAR DROPBEAR               \E[0m"
			echo -e "\n\033[1;33mPORTAS\033[1;37m: \033[1;32m$dpbr\n"
			echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mLIMITER DROPBEAR $stats\033[0m"
			echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mALTERAR PORTA DROPBEAR\033[0m"
			echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mREMOVER DROPBEAR\033[0m"
			echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mVOLTAR\033[0m\n"
			echo -ne "\033[1;32mOQUE DESEJA FAZER \033[1;33m?\033[1;37m "
			read -r resposta

			if [[ "$resposta" == '1' ]]; then
				clear
				if ps x | grep -E "[d]roplimiter|[l]imiter" >/dev/null 2>&1; then
					echo -e "\033[1;32mParando o limiter... \033[0m\n"
					fun_stplimiter() {
						pkill -9 -f "droplimiter" 2>/dev/null || pkill -9 -f "limiter" 2>/dev/null
						command -v screen >/dev/null 2>&1 && screen -wipe >/dev/null 2>&1
					}
					fun_bar 'fun_stplimiter' 'sleep 2'
					echo -e "\n\033[1;31m LIMITER DESATIVADO \033[0m"
					sleep 3
					fun_drop
				else
					echo -e "\n\033[1;32mIniciando o limiter... \033[0m\n"
					fun_bar 'screen -d -m -t limiter droplimiter' 'sleep 3'
					echo -e "\n\033[1;32m  LIMITER ATIVADO \033[0m"
					sleep 3
					fun_drop
				fi
			elif [[ "$resposta" == '2' ]]; then
				echo ""
				echo -ne "\033[1;32mQUAL PORTA DESEJA UTILIZAR \033[1;33m?\033[1;37m "
				read -r pt
				[[ -z "$pt" || ! "$pt" =~ ^[0-9]+$ ]] && {
					echo -e "\n\033[1;31mPorta invalida!"
					sleep 2
					fun_drop
					return
				}
				verif_ptrs "$pt" || return
				var1=$(grep -E '^DROPBEAR_PORT=' /etc/default/dropbear 2>/dev/null | cut -d'=' -f2 | tr -d '"')
				echo -e "\n\033[1;32mALTERANDO PORTA DROPBEAR!\n"
				if [[ -n "$var1" ]]; then
					sed -i "s/^DROPBEAR_PORT=.*/DROPBEAR_PORT=$pt/" /etc/default/dropbear
				fi
				fun_bar 'sleep 2'
				echo -e "\n\033[1;32mREINICIANDO DROPBEAR!\n"
				fun_bar 'systemctl restart dropbear 2>/dev/null || service dropbear restart 2>/dev/null || /etc/init.d/dropbear restart'
				echo -e "\n\033[1;32mPORTA ALTERADA COM SUCESSO!"
				sleep 3
				clear
				fun_conexao
			elif [[ "$resposta" == '3' ]]; then
				echo -e "\n\033[1;32mREMOVENDO O DROPBEAR !\033[0m\n"
				fun_dropunistall() {
					systemctl stop dropbear 2>/dev/null || service dropbear stop 2>/dev/null || /etc/init.d/dropbear stop 2>/dev/null
					apt-get purge -y dropbear dropbear-run dropbear-bin >/dev/null 2>&1
					apt-get autoremove -y >/dev/null 2>&1
					rm -rf /etc/default/dropbear
				}
				fun_bar 'fun_dropunistall'
				echo -e "\n\033[1;32mDROPBEAR REMOVIDO COM SUCESSO !\033[0m"
				sleep 3
				clear
				fun_conexao
			elif [[ "$resposta" == '0' ]]; then
				echo -e "\n\033[1;31mRetornando...\033[0m"
				sleep 2
				fun_conexao
			else
				echo -e "\n\033[1;31mOpcao invalida...\033[0m"
				sleep 2
				fun_conexao
			fi
		else
			clear
			echo -e "\E[44;1;37m           INSTALADOR DROPBEAR              \E[0m"
			echo -e "\n\033[1;33mVC ESTA PRESTES A INSTALAR O DROPBEAR !\033[0m\n"
			echo -ne "\033[1;32mDESEJA CONTINUAR \033[1;31m? \033[1;33m[s/n]:\033[1;37m "
			read -r resposta
			if [[ "${resposta,,}" == 's' ]]; then
				echo -e "\n\033[1;33mDEFINA UMA PORTA PARA O DROPBEAR !\033[0m\n"
				echo -ne "\033[1;32mQUAL A PORTA \033[1;33m?\033[1;37m "
				read -r porta
				if [[ -z "$porta" || ! "$porta" =~ ^[0-9]+$ ]]; then
					echo -e "\n\033[1;31mPorta invalida!"
					sleep 3
					clear
					fun_conexao
					return
				fi
				verif_ptrs "$porta" || return

				echo -e "\n\033[1;32mINSTALANDO O DROPBEAR ! \033[0m\n"
				fun_instdrop() {
					apt-get update -y
					apt-get install -y dropbear
				}
				fun_bar 'fun_instdrop'

				fun_ports() {
					[[ -f /etc/default/dropbear ]] && {
						sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear
						sed -i "s/^DROPBEAR_PORT=.*/DROPBEAR_PORT=$porta/" /etc/default/dropbear
						sed -i 's/^DROPBEAR_EXTRA_ARGS=.*/DROPBEAR_EXTRA_ARGS="-p 110"/' /etc/default/dropbear
					}
				}
				echo -e "\n\033[1;32mCONFIGURANDO PORTA DROPBEAR !\033[0m\n"
				fun_bar 'fun_ports'

				grep -v "^PasswordAuthentication " /etc/ssh/sshd_config >/tmp/passlogin && mv /tmp/passlogin /etc/ssh/sshd_config
				echo "PasswordAuthentication yes" >>/etc/ssh/sshd_config
				grep -v "^PermitTunnel " /etc/ssh/sshd_config >/tmp/ssh_tun && mv /tmp/ssh_tun /etc/ssh/sshd_config
				echo "PermitTunnel yes" >>/etc/ssh/sshd_config

				echo -e "\n\033[1;32mFINALIZANDO INSTALACAO !\033[0m\n"
				fun_ondrop() {
					systemctl restart dropbear 2>/dev/null || service dropbear restart 2>/dev/null || /etc/init.d/dropbear restart
				}
				fun_bar 'fun_ondrop' 'sleep 1'
				echo -e "\n\033[1;32mINSTALACAO CONCLUIDA \033[1
